# Copy to .env.local and fill in. Never put secrets here: every VITE_ value ships to the browser.

# RSVP destination (used when rsvp.mode = 'endpoint' in src/config/wedding.ts).
# A Google Apps Script web-app URL or a Formspree form URL. See README "RSVP".
VITE_RSVP_ENDPOINT=

# Public URL of the deployed site. Enables the WhatsApp / social preview image.
VITE_SITE_URL=
